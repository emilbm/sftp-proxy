# Copy to `.env` and fill in. The four settings marked "required" are all it
# needs to run; everything else has a sensible default.

# ------------------------------------------------------------- SFTP server ---
# Required. Where the files live. A LAN IP or hostname is fine.
SFTP_HOST=
SFTP_PORT=22
# Required. Ideally an account that can only read the public folder.
SFTP_USERNAME=

# Required: one of these two.
SFTP_PASSWORD=
# Path *inside the container* to a private key - mount it in compose.yaml.
# SFTP_PRIVATE_KEY_PATH=/run/secrets/sftp_key
# SFTP_PRIVATE_KEY_PASSPHRASE=

# Pin the server's host key so nothing else can pose as it. Leave it empty on
# first start: the log prints the server's fingerprint, then paste it here.
# Or run, from any machine that can reach it:
#   ssh-keyscan -p 22 <host> 2>/dev/null | ssh-keygen -lf -
# and take the SHA256:... value for the key type the server prefers (ed25519).
SFTP_HOST_KEY_SHA256=

# The folder to publish. Relative paths start in the SFTP user's login
# directory, so `public` means ~/public; an absolute path works too.
SFTP_PUBLIC_DIR=public

SFTP_CONNECT_TIMEOUT_SECONDS=10
# The SFTP connection is closed after this long without a visitor. 0 keeps it.
SFTP_IDLE_CLOSE_SECONDS=300

# ---------------------------------------------------------------- Website ---
# Required. The one password that unlocks the site. At least 8 characters;
# use something long if the site is reachable from the internet.
SITE_PASSWORD=

# Signs the login cookie. Without it, a random one is made at each start and
# every restart signs everyone out. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# How long a sign-in lasts.
SESSION_DAYS=30

# After this many wrong passwords from one visitor, further attempts are
# refused until the oldest failure is this many minutes old.
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# Set to true when a Cloudflare tunnel or reverse proxy sits in front, so the
# lockout above applies per visitor (from CF-Connecting-IP / X-Forwarded-For)
# instead of to the proxy as a whole. Leave false when exposed directly, or
# anyone could pick their own address and dodge the lockout.
TRUST_PROXY=false

# Shown in the page header and browser tab.
SITE_TITLE=Files

# List files and folders whose names start with a dot.
SHOW_HIDDEN=false

WEB_PORT=8080
WEB_ADDRESS=0.0.0.0

# --------------------------------------------------------------- Logging ---
TZ=Europe/Copenhagen
# info | debug | warn | error
LOG_LEVEL=info

# --------------------------------------------------------- Error reporting ---
# Sentry-protocol error reporting; GlitchTip ingests the same envelope format.
# Leave empty to disable it entirely - nothing is sent and no connection is
# attempted.
#
# GlitchTip shows the DSN under Settings -> Projects -> <project> -> keys.
# A malformed DSN fails at startup rather than silently dropping errors later.
# Once set, sign in and visit /throw to send a test event.
SENTRY_DSN=

SENTRY_ENVIRONMENT=production
# Stamped into published images by CI; set it here only to override.
# SENTRY_RELEASE=
# Defaults to the container hostname.
SENTRY_SERVER_NAME=
# An SFTP outage could otherwise generate an event on every page view.
SENTRY_MAX_EVENTS_PER_MINUTE=30
